# Privy app (create at dashboard.privy.io; enable Arc Testnet 5042002 as a custom chain)
NEXT_PUBLIC_PRIVY_APP_ID=

# Deployed Griddy contract address on Arc Testnet (chainId 5042002)
NEXT_PUBLIC_GRIDDY_ADDR=

# Optional dedicated RPC endpoint; the public Arc Testnet RPC
# (https://rpc.testnet.arc.network) is used as fallback
NEXT_PUBLIC_ALCHEMY_RPC=

# Chain overrides — defaults are Arc Testnet: chainId 5042002,
# RPC https://rpc.testnet.arc.network, explorer https://testnet.arcscan.app
# NEXT_PUBLIC_CHAIN_ID=5042002
# NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.network
# NEXT_PUBLIC_EXPLORER=https://testnet.arcscan.app

# Keeper SSE feed (e.g. https://your-keeper.up.railway.app/events); empty = RPC polling only
NEXT_PUBLIC_SSE_URL=

# Supabase history mirror (optional; empty = history starts blank and only
# shows rounds resolved while the page is open). Schema: services/keeper/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON=

# Set to "true" only if Privy gas sponsorship is configured for chain 5042002
NEXT_PUBLIC_GAS_SPONSOR=false
